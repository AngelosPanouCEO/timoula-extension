{
  "name": "timoula",
  "private": true,
  "version": "0.1.0",
  "description": "Import-cost calculator for used cars bought in the EU and registered in Greece (Chrome extension).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace apps/extension",
    "dev": "npm run dev --workspace apps/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/extension",
    "check": "npm run typecheck && npm test",
    "e2e": "node apps/extension/build.mjs --e2e && node scripts/e2e.mjs",
    "build:e2e": "node apps/extension/build.mjs --e2e"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.18.0",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
